{
  "workspaces": [
    "apps/site",
    "apps/finance/web",
    "apps/tenders/web",
    "packages/ui"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generate-public-route-html.mjs",
    "build:main": "vite build --config vite.main.config.ts && node scripts/generate-public-route-html.mjs dist/main",
    "build:tenders": "vite build --config vite.tenders.config.ts",
    "build:probe": "node scripts/build-hosting-probe.mjs",
    "preview": "vite preview",
    "preview:main": "vite preview --config vite.main.config.ts",
    "preview:tenders": "vite preview --config vite.tenders.config.ts",
    "preview:probe": "vite preview --config vite.probe.config.ts",
    "test:build": "tsx --test scripts/frontendBuild.test.ts",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && tsx --test scripts/frontBoundaries.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vite": "^8.1.3",
    "vite-plugin-pwa": "^1.3.0"
  }
}
