{
  "name": "sistema-financeiro-backend",
  "version": "1.1.0",
  "releaseDate": "2026-03-21",
  "description": "Backend do Sistema de Controle Financeiro com PostgreSQL",
  "main": "src/server.ts",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "set DOTENV_CONFIG_PATH=../.env.dev&& tsx watch src/server.ts",
    "dev:prod-db": "tsx watch src/server.ts",
    "build": "tsc --noEmit",
    "test": "tsx --test src/services/*.test.ts src/utils/*.test.ts src/modules/tenders/**/*.test.ts",
    "test:tenders-db": "set TENDERS_DB_TESTS=1&& set DOTENV_CONFIG_PATH=../.env.dev&& tsx --test src/modules/tenders/**/*.db.test.ts",
    "tenders": "tsx src/modules/tenders/collector/cli.ts",
    "tenders:dev": "set DOTENV_CONFIG_PATH=../.env.dev&& tsx src/modules/tenders/collector/cli.ts",
    "daily-jobs": "tsx scripts/dailyJobs.ts",
    "migrations:status": "tsx scripts/migrations.ts status",
    "migrations:aplicar": "tsx scripts/migrations.ts aplicar",
    "migrations:registrar-existentes": "tsx scripts/migrations.ts registrar-existentes"
  },
  "keywords": [
    "financeiro",
    "postgresql",
    "api",
    "nodejs"
  ],
  "author": "Rodrigo",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.45.2",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "jimp": "^1.6.0",
    "jsonwebtoken": "^9.0.2",
    "jsqr": "^1.4.0",
    "mercadopago": "^2.12.0",
    "multer": "^2.1.1",
    "node-fetch": "^2.7.0",
    "openai": "^6.27.0",
    "pdf-parse": "^1.1.1",
    "pdfmake": "^0.3.11",
    "pg": "^8.11.3",
    "sharp": "^0.34.5",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.22.4",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.20.0",
    "@types/web-push": "^3.6.4",
    "nodemon": "^3.0.2",
    "typescript": "^5.9.3"
  }
}
